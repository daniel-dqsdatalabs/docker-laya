# Execute cada bloco separadamente no REST Client do VS Code.
# A autenticação Basic usa BASIC_AUTH do .env na raiz (usuario:senha).
# O cliente sobe os diretórios até encontrar esse arquivo e preserva ':' na senha.
@baseUrl = http://localhost:8000
@basicAuth = {{$dotenv BASIC_AUTH}}

### 01. Saúde: endpoint público, sem autenticação
GET {{baseUrl}}/healthz

### 02. Checkpoints disponíveis e carregados
GET {{baseUrl}}/models
Authorization: Basic {{basicAuth}}

### 03. Presets disponíveis
GET {{baseUrl}}/presets
Authorization: Basic {{basicAuth}}

### 04. Detectar o idioma antes de escolher um modelo
POST {{baseUrl}}/detect
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "Minha fatura veio com uma cobrança duplicada."
}

### 05. Limpar e estruturar um email; use a resposta como state em outra predição
POST {{baseUrl}}/email/state
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "subject": "Cobrança duplicada",
  "body": "Olá, fui cobrado duas vezes neste mês. Preciso de ajuda.\n\nAtenciosamente,\nCliente",
  "sender": "cliente@example.com",
  "clean": true
}

### 06. Escolher UMA categoria dentro de uma LISTA de categorias
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "Minha fatura veio com uma cobrança duplicada. Preciso de estorno.",
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual categoria descreve melhor esta mensagem?",
      "criteria": ["financeiro", "suporte_tecnico", "comercial", "cancelamento", "outros"]
    }
  }
}

### 07. Categorias com descrições: útil para explicar opções semelhantes
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "Não consigo acessar minha conta depois de trocar de celular.",
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual equipe deve atender esta solicitação?",
      "criteria": {
        "financeiro": "Faturas, pagamentos, cobranças e reembolsos.",
        "suporte_tecnico": "Erros, problemas de acesso e falhas no aplicativo.",
        "comercial": "Preços, planos e novas contratações.",
        "cancelamento": "Encerramento de contrato ou assinatura.",
        "outros": "Assuntos não contemplados pelas demais categorias."
      }
    }
  }
}

### 08. Combinar categoria, pontuação de urgência e decisão binária
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "The system is down and our entire team is blocked. Please refund today's charge.",
  "model": "typed-decisions",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which team should handle this request?",
      "criteria": ["billing", "technical_support", "sales"]
    },
    "urgency": {
      "type": "score",
      "instructions": "How urgent is this request?",
      "criteria": ["low", "medium", "high", "critical"]
    },
    "refund": {
      "type": "noul",
      "instructions": "Does the customer request a refund?",
      "criteria": {"false": "No refund requested.", "true": "A refund is requested."}
    }
  }
}

### 09. Classificar uma conversa inteira
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": [
    {"role": "user", "content": "Quero cancelar minha assinatura."},
    {"role": "assistant", "content": "Pode me informar o motivo?"},
    {"role": "user", "content": "Não vou mais utilizar o serviço."}
  ],
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual é a intenção principal do cliente nesta conversa?",
      "criteria": ["contratacao", "duvida", "cancelamento", "suporte"]
    }
  }
}

### 10. Usar um objeto JSON como estado
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": {
    "assunto": "Orçamento para 50 usuários",
    "mensagem": "Gostaria de conhecer os planos empresariais.",
    "canal": "email"
  },
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual categoria corresponde a esta solicitação?",
      "criteria": ["comercial", "financeiro", "suporte_tecnico"]
    }
  }
}

### 11. Usar um preset sem enviar questions; model omitido permite roteamento automático
POST {{baseUrl}}/predict
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "I was billed twice this month. Please refund the duplicate charge.",
  "preset": "triage"
}

### 12. Classificar vários textos com a mesma lista de categorias
POST {{baseUrl}}/predict/bulk
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "states": [
    "Preciso da segunda via do boleto.",
    "O aplicativo apresenta erro ao iniciar.",
    "Quero contratar um plano para minha empresa."
  ],
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual categoria descreve melhor esta mensagem?",
      "criteria": ["financeiro", "suporte_tecnico", "comercial", "outros"]
    }
  }
}

### 13. Lote com modelo e perguntas específicos por item (sem preset compartilhado)
POST {{baseUrl}}/predict/bulk
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "model": "multilingual",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual categoria descreve melhor esta mensagem?",
      "criteria": ["financeiro", "suporte_tecnico", "comercial"]
    }
  },
  "items": [
    {"state": "Preciso de uma nota fiscal."},
    {
      "state": "Please cancel my subscription.",
      "model": "english",
      "questions": {
        "intent": {
          "type": "choice",
          "instructions": "What is the customer's intent?",
          "criteria": ["cancel", "upgrade", "support"]
        }
      }
    }
  ]
}

### 14. Formato compatível com SystemOne / TypeSafe
POST {{baseUrl}}/v1/systemone
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "state": "Quero conhecer os preços do plano empresarial.",
  "model": "laya-multilingual",
  "session_id": "exemplo-categorias-001",
  "user": "usuario-exemplo",
  "questions": {
    "categoria": {
      "type": "choice",
      "instructions": "Qual categoria descreve melhor esta mensagem?",
      "criteria": ["financeiro", "suporte_tecnico", "comercial", "outros"]
    }
  }
}
