# Comma-separated API keys. Leave empty to disable API-key auth.
API_KEYS=key1,key2

# HTTP port (host and container).
PORT=8000

# Comma-separated user:password pairs for HTTP Basic auth. Optional.
BASIC_AUTH=admin:secret

# Max states accepted per /predict/bulk request.
MAX_BULK_ITEMS=256

# Checkpoints to keep resident: english, multilingual, typed-decisions.
# Preload more than one to route languages without reloading.
MODELS=english

# Optional: override the bundled repo (local path or mirror).
MODEL_ID=convaiinnovations/laya
MODEL_SUBFOLDER=

# cpu | cuda
DEVICE=cpu

# Hugging Face access token. Authenticates checkpoint downloads.
HF_TOKEN=
